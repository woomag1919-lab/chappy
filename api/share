// CoreLingual v12 - secure share API contract (DB-ready scaffold)
// DB is intentionally not wired yet. Once Neon is configured, this endpoint should:
// POST: validate payload -> generate 256-bit random token server-side -> store only approved result fields + expiry -> return /share/<token>
// GET: look up by token -> enforce expiry/deletion -> return only that shared result.
// Never use sequential IDs, client-supplied IDs, screenshots, raw conversation text, or profile details.

export default async function handler(req, res) {
  if (req.method === 'POST') {
    return res.status(503).json({
      error: '共有機能のDBがまだ接続されていません。Neon DBを設定したあとに共有機能を有効化できます。'
    });
  }
  if (req.method === 'GET') {
    return res.status(503).json({
      error: '共有機能のDBがまだ接続されていません。'
    });
  }
  res.setHeader('Allow', 'GET, POST');
  return res.status(405).json({ error: 'Method Not Allowed' });
}

